{
  "id": "aiplus",
  "name": "AI 助手 Pro",
  "version": "0.5.7",
  "author": "异天庄主",
  "description": "启动页右侧的 AI 对话卡片：多会话聊天、流式输出、草稿不丢，可用 agent.md 记录长期偏好；联网搜索与 MC百科资料查询；下载安装 Modrinth / CurseForge / 整合包 / 直链内容；读实例配置、模组与崩溃日志帮你排查问题。",
  "entry": "AiPlusPlugin",
  "dll": "AiPlus.Plugin.dll",
  "minApiVersion": 10,
  "license": "GPL-3.0",
  "permissions": {
    "ui": true,
    "net": {
      "hosts": [
        "mcmod.cn",
        "*.mcmod.cn",
        "api.modrinth.com",
        "cdn.modrinth.com",
        "api.curseforge.com",
        "mediafilez.forgecdn.net",
        "edge.forgecdn.net",
        "media.forgecdn.net",
        "mod.mcimirror.top",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "github.com",
        "piston-meta.mojang.com",
        "piston-data.mojang.com",
        "launchermeta.mojang.com",
        "bmclapi2.bangbang93.com"
      ]
    },
    "net.dynamic": true,
    "args": true,
    "plugins": true,
    "instance.read": true,
    "instance.select": true,
    "instance.install": true,
    "instance.write": true,
    "modpack.install": true,
    "files": {
      "read": [
        "S:\\mc\\luncher\\plugin\\AI_main\\.minecraft\\versions\\*",
        "..\\.minecraft\\versions\\*"
      ],
      "write": [
        "S:\\mc\\luncher\\plugin\\AI_main\\.minecraft\\versions\\*",
        "..\\.minecraft\\versions\\*"
      ]
    },
    "logs.read": true,
    "mods.read": true,
    "mods.write": true,
    "launch": true,
    "settings.global": true
  }
}
